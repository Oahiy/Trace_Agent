# Optional local overrides. Blank values use validated defaults.
# This file has no credentials. The application does not load .env automatically.
TRACEAGENT_LOCAL_MODEL_URL=
TRACEAGENT_MODEL_TIMEOUT_SECONDS=
TRACEAGENT_MAX_FILE_BYTES=
TRACEAGENT_MAX_PDF_PAGES=
TRACEAGENT_MAX_TEXT_CHARACTERS=
TRACEAGENT_MAX_QUESTION_CHARACTERS=
# Database settings are loaded only by explicit database commands, not /health.
TRACEAGENT_DB_URL=
TRACEAGENT_DB_CONNECT_TIMEOUT_SECONDS=
TRACEAGENT_DB_POOL_TIMEOUT_SECONDS=
TRACEAGENT_DB_STATEMENT_TIMEOUT_MS=
TRACEAGENT_DB_LOCK_TIMEOUT_MS=
TRACEAGENT_DB_IDLE_TRANSACTION_TIMEOUT_MS=
# Upload root must be absolute; blank uses the project-managed .cache/day4/uploads.
TRACEAGENT_UPLOAD_ROOT=
TRACEAGENT_UPLOAD_TIMEOUT_SECONDS=
# Parsing subprocess wall timeout, default 60 seconds, maximum 120.
TRACEAGENT_PARSE_TIMEOUT_SECONDS=
# Seed-only secrets, generated once by scripts.day4 prepare; never commit values.
TRACEAGENT_SEED_API_KEY_A=
TRACEAGENT_SEED_API_KEY_B=
TRACEAGENT_QUEUE_ENABLED=false
# Populate only from a protected local credential file; never commit a real URL.
TRACEAGENT_QUEUE_URL=
TRACEAGENT_QUEUE_NAME=traceagent-parse
TRACEAGENT_QUEUE_EXECUTION_TIMEOUT_SECONDS=300
TRACEAGENT_QUEUE_WAIT_TIMEOUT_SECONDS=1800
